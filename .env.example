# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Microsoft Clarity (Heatmaps)
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Netlify function only. Configure these on the production project's server;
# never expose the CRM token through a NEXT_PUBLIC variable.
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional: JSON mapping of attribution parameter names to existing CRM custom
# field IDs (utm_source, utm_medium, utm_campaign, utm_term, utm_content, gclid,
# gbraid, wbraid, landing_page). Campaign notes work without this mapping;
# dedicated fields provide structured reporting when real IDs are supplied.
GHL_ATTRIBUTION_FIELD_IDS={}
